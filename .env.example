# Copy to .env.local for npm run dev; to .env for npm start / Docker Compose.
# The dev launcher manages its own database and overrides DATABASE_URL.
# For Compose, replace the password and set the database host to db.
DATABASE_URL=postgres://avalon:change-me@localhost:5432/avalon
POSTGRES_PASSWORD=change-me
# Includes one connection reserved for the single-process ownership lock.
PG_POOL_MAX=10
HOST=0.0.0.0
PORT=3000
# npm run dev uses http://localhost:5173; production requires your HTTPS origin.
PUBLIC_ORIGIN=http://localhost:3000
ENVIRONMENT=development

# Optional, build-time only. Blank keeps all static files on the app origin.
# Example: https://static.example.com/avalon/
STATIC_ASSET_BASE_URL=

# The current auth implementation explicitly supports Pangda Auth.
# Register your own client, audience and callback; see README.md.
OIDC_ISSUER=https://auth.pangda.app
OIDC_CLIENT_ID=
OIDC_RESOURCE=
OIDC_CLIENT_SECRET=
# Generate a strong value once and retain it across deployments.
OIDC_SESSION_SECRET=
