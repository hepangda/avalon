{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "avalon",
  "main": "worker/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "avalon.pangda.app",
      "zone_name": "pangda.app",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false
    }
  ],
  "vars": {
    "OIDC_ISSUER": "https://auth.pangda.app",
    "OIDC_CLIENT_ID": "avalon",
    "OIDC_RESOURCE": "https://avalon.pangda.app/createRoom",
    "ENVIRONMENT": "production"
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/rooms/*"]
  },
  "flagship": [
    {
      "binding": "FLAGS",
      "app_id": "134aa4be-47b7-435f-a9b8-2d6b7d8f5922",
      "remote": true
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "RoomDurableObject" },
      { "name": "REPLAY", "class_name": "ReplayDurableObject" },
      { "name": "ACCOUNT_PROFILE", "class_name": "AccountProfileDurableObject" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RoomDurableObject", "ReplayDurableObject"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["AccountProfileDurableObject"]
    }
  ]
}
