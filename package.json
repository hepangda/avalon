{
  "name": "avalon-online",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node scripts/dev.mjs --server-only",
    "db:up": "node scripts/dev.mjs --db-only",
    "db:down": "node scripts/dev.mjs --db-down",
    "build": "npm run build:web && npm run build:server",
    "build:web": "npm run build -w frontend",
    "build:server": "cargo build --release --locked --bin avalon-server --manifest-path backend/Cargo.toml",
    "start": "backend/target/release/avalon-server",
    "preview": "npm run start",
    "typecheck": "npm run typecheck -w frontend",
    "lint": "npm run lint -w frontend",
    "test": "npm test -w frontend && node --test scripts/*.test.mjs",
    "test:watch": "npm run test:watch -w frontend",
    "test:dev": "node --test scripts/dev-env.test.mjs",
    "test:rust": "cargo test --locked --manifest-path backend/Cargo.toml",
    "commit": "node scripts/commit.mjs",
    "commit:check": "node scripts/commit.mjs --check",
    "test:rust:replay:full": "cargo test --locked --manifest-path backend/Cargo.toml --test engine_resolved all_resolved_rules_and_private_views_match_independent_oracle -- --ignored --exact",
    "check:rust": "cargo fmt --all --manifest-path backend/Cargo.toml --check && cargo clippy --locked --manifest-path backend/Cargo.toml --workspace --all-targets -- -D warnings",
    "voices:generate": "node frontend/scripts/generate-voices.mjs",
    "static:check": "node frontend/scripts/static/publish-static.mjs",
    "static:upload": "node frontend/scripts/static/publish-static.mjs --upload",
    "static:verify": "node frontend/scripts/static/verify-static.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "dotenv": "^18.0.4"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.19.0"
}
